# Application Environment
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production

# Database Configuration
# For MySQL: mysql+pymysql://username:password@hostname:3306/dbname
# For Local/Fallback: sqlite:///banking.db
DATABASE_URL=sqlite:///banking.db

# Admin Initial Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_EMAIL=admin@bankingsystem.com

# Employee Initial Credentials
DEFAULT_EMPLOYEE_USERNAME=employee
DEFAULT_EMPLOYEE_PASSWORD=Employee@123
DEFAULT_EMPLOYEE_EMAIL=employee@bankingsystem.com

# Server Port
PORT=5000
